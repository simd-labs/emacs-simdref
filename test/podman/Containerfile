FROM docker.io/library/debian:trixie

# emacs-nox gives Emacs 30 in trixie.  curl fetches the pinned uv
# release, tar and gzip unpack it, ca-certificates cover TLS.  git
# keeps the vc probe in find-file-hook quiet, like on a user machine.
# python3 and python3-venv build the rass venv for the preset test.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      emacs-nox ca-certificates curl gzip git tar python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*

# The rass venv holds the rassumfrassum that simdref-rass.py subclasses.
# The pin matches the one in simdref.el.
RUN python3 -m venv /opt/rass \
 && /opt/rass/bin/pip install --no-cache-dir 'rassumfrassum>=0.3.5,<0.4'

# Fresh HOME, owned by the host user that --userns=keep-id maps in.
ENV HOME=/tmp/home
RUN mkdir -p /tmp/home && chmod 0777 /tmp/home

WORKDIR /src
ENTRYPOINT ["bash", "test/podman/run.sh"]
